APP_NAME=TRACS
APP_ENV=production
APP_URL=https://tracs.example.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tracs
DB_USER=tracs_app
DB_PASS=replace-with-a-long-random-password

TIMEZONE=Asia/Jakarta

TRACS_2FA_BYPASS_IDENTIFIERS=

# Opt-in request benchmarks. Keep disabled during normal operation.
TRACS_PERF_DIAGNOSTICS=0
TRACS_PERF_SAMPLE_RATE=0.1

# PageFleets website screenshot API (dashboard widget).
# Generate a key from the PageFleets administrator portal.
PAGEFLEETS_API_KEY=

# IDCloudHost billing API (Server Health > Billing insight).
# Generate a key at https://app.idcloudhost.com/ — docs at https://api.idcloudhost.com/
IDCLOUDHOST_API_KEY=
